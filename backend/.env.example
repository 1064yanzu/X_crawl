# ============================================================
#  X_crawl 配置模板 - 复制为 .env 并填写实际值
# ============================================================

# --- 浏览器配置 ---
# 浏览器用户数据目录（保留登录状态，留空则使用系统默认）
BROWSER_USER_DATA_PATH=

# 浏览器可执行文件路径（留空则自动检测）
BROWSER_EXEC_PATH=

# 代理配置（格式：http://ip:port 或 socks5://ip:port，留空则不使用代理）
BROWSER_PROXY=

# 是否无头模式（true/false），建议调试时设为 false
BROWSER_HEADLESS=false

# --- API 配置 ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# 爬虫等待超时（秒）
CRAWLER_TIMEOUT=30

# 翻页间隔（秒）
CRAWLER_PAGE_INTERVAL=2

# --- 原始响应持久化 ---
# 是否将每次请求的原始 JSON 响应保存到磁盘（true/false）
SAVE_RAW_RESPONSES=true

# 原始响应存储根目录（相对于 backend/ 或绝对路径）
RAW_RESPONSES_DIR=raw_responses

# 每个任务最多保存页数（0 = 不限制）
RAW_RESPONSES_MAX_PAGES=0
